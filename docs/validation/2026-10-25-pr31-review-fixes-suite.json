  "runner_source": [
    "\"\"\"Plan-local runner with durable logs and concise output.\"\"\"",
    "from pathlib import Path",
    "import sys",
    "import unittest",
    "import tempfile",
    "import json",
    "",
    "# Windows may expose TEMP through an 8.3 alias; fixtures compare real paths.",
    "tempfile.tempdir=str(Path(tempfile.gettempdir()).resolve())",
    "",
    "root = Path.cwd()",
    "sys.path.insert(0,str(root/'tests'))",
    "sys.path.insert(0,str(root/'scripts'))",
    "workspace = Path(__file__).resolve().parent",
    "label = sys.argv[1]",
    "suite = unittest.TestSuite()",
    "patterns=sys.argv[2:] or ['test_*.py']",
    "if len(patterns)==1 and patterns[0].startswith('@'):",
    "    patterns=json.loads((workspace/patterns[0][1:]).read_text(encoding='utf-8'))",
    "for pattern in patterns:",
    "    suite.addTests(unittest.defaultTestLoader.discover(str(root/'tests'), pattern=pattern))",
    "with (workspace/(label+'.log')).open('w',encoding='utf-8') as log:",
    "    result = unittest.TextTestRunner(stream=log,verbosity=2).run(suite)",
    "print(f'{label}: {result.testsRun} tests; {len(result.failures)} failures; {len(result.errors)} errors; {len(result.skipped)} skipped')",
    "if not result.wasSuccessful():",
    "    print((workspace/(label+'.log')).read_text(encoding='utf-8')[-16000:])",
    "sys.exit(not result.wasSuccessful())"
  ],
